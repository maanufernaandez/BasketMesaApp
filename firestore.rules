rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Cada usuario solo puede ver y modificar SUS partidos y sanciones.
    // Las consultas de la app ya filtran por userId, así que cumplen la regla.
    match /partidos/{documentId} {
      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }

    match /sanciones/{documentId} {
      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }
    match /tarifas_reglas/{reglaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == "WcflrnPzNoMOpFBlz21qHGX4C5p2";
    }

    match /desplazamientos_reglas/{reglaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == "WcflrnPzNoMOpFBlz21qHGX4C5p2";
    }

    match /dietas_reglas/{reglaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == "WcflrnPzNoMOpFBlz21qHGX4C5p2";
    }

    match /app_meta/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == "WcflrnPzNoMOpFBlz21qHGX4C5p2";
    }
  }
}